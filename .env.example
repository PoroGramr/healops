# Bind locally; never expose this unauthenticated dashboard to the internet.
HEALOPS_API_TOKEN=replace-with-a-long-random-secret
HEALOPS_WORKER_TOKEN=replace-with-a-separate-long-random-secret
HEALOPS_DB_URL=sqlite:///./data/healops.db
HEALOPS_MANAGED_CONTAINERS=healops-broken-app
HEALOPS_AUTO_RESTART=false
HEALOPS_RESTART_LIMIT=2
HEALOPS_HTTP_HEALTH_CONTAINER=
HEALOPS_HTTP_HEALTH_URL=
HEALOPS_CAPTURE_LOGS=true
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
